diff --git a/src/dvdread/dvd_filesystem.h b/src/dvdread/dvd_filesystem.h
new file mode 100644
index 0000000..291f4d9
--- /dev/null
+++ b/src/dvdread/dvd_filesystem.h
@@ -0,0 +1,124 @@
+/*
+ * This file is part of libdvdread
+ * Copyright (C) 2022 VideoLAN
+ *
