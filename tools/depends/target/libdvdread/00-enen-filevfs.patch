diff --git a/src/file/dir_posix.c b/src/file/dir_posix.c
new file mode 100644
index 0000000..f55e62a
--- /dev/null
+++ b/src/file/dir_posix.c
@@ -0,0 +1,98 @@
+/*
+ * This file is part of libdvdread
+ * Copyright (C) 2022 VideoLAN
+ *
