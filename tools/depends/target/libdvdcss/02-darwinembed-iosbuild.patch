From 29e677cffc460850968caf748af51b17247b1005 Mon Sep 17 00:00:00 2001
From: Memphiz <memphis@machzwo.de>
Date: Sat, 8 Sep 2018 15:38:11 +0200
Subject: [PATCH] [xbmc][libdvdcss][ios] Allow compilation on ios

Based on patch by WayneP
---
 src/device.c |  2 ++
 src/ioctl.c  | 27 ++++++++++++++++++++++++---
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/src/device.c b/src/device.c
index a50cea2..e49f6f4 100644
--- a/src/device.c
+++ b/src/device.c
@@ -123,6 +123,8 @@
     if( ulMode & OPEN_FLAGS_DASD )
         return 1;
 
+    return 0;
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
     return 0;
 #else
     struct stat fileinfo;
diff --git a/src/ioctl.c b/src/ioctl.c
index 07bcb0d..e55ca6e 100644
--- a/src/ioctl.c
+++ b/src/ioctl.c
@@ -223,10 +223,11 @@
                         p_buffer, sizeof(p_buffer), &ulDataLen);
 
     *pi_copyright = p_buffer[ 4 ];
-
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+    *pi_copyright = 0;
+    i_ret = 0;
 #else
 #   error "DVD ioctls are unavailable on this system"
-
 #endif
     return i_ret;
 }
@@ -356,7 +357,8 @@
     }
 
     memcpy( p_key, p_buffer + 4, DVD_DISCKEY_SIZE );
-
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -487,6 +489,8 @@
 
     memcpy( p_key, p_buffer + 5, DVD_KEY_SIZE );
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -584,6 +588,8 @@
 
     *pi_agid = p_buffer[ 7 ] >> 6;
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -692,6 +698,8 @@
 
     memcpy( p_challenge, p_buffer + 4, DVD_CHALLENGE_SIZE );
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -802,6 +810,8 @@
 
     *pi_asf = p_buffer[ 7 ] & 1;
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -905,6 +915,8 @@
 
     memcpy( p_key, p_buffer + 4, DVD_KEY_SIZE );
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -988,6 +1000,9 @@
     i_ret = DosDevIOCtl(i_fd, IOCTL_CDROMDISK, CDROMDISK_EXECMD,
                         &sdc, sizeof(sdc), &ulParamLen,
                         NULL, 0, &ulDataLen);
+
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -1288,6 +1303,8 @@
                          &sdc, sizeof(sdc), &ulParamLen,
                          p_buffer, sizeof(p_buffer), &ulDataLen );
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -1397,6 +1414,8 @@
                          &sdc, sizeof(sdc), &ulParamLen,
                          p_buffer, sizeof(p_buffer), &ulDataLen );
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
@@ -1524,6 +1543,8 @@
     *p_mask = p_buffer[ 5 ];
     *p_scheme = p_buffer[ 6 ];
 
+#elif defined(__APPLE__) && (defined(__arm__) || defined(__aarch64__))
+// nothing
 #else
 #   error "DVD ioctls are unavailable on this system"
 
