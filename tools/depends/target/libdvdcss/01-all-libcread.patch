From 2697d1ddc0ec3a788b921afd67ce0476ed0e6563 Mon Sep 17 00:00:00 2001
From: Voyager1 <voyager@xbmc.org>
Date: Sat, 13 Feb 2016 20:44:21 +0100
Subject: [PATCH] [xbmc][libdvdcss][common] better handle partial read in
 libc_read

---
 src/device.c | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/device.c b/src/device.c
index 34b610b..a50cea2 100644
--- a/src/device.c
+++ b/src/device.c
@@ -636,13 +636,21 @@
     off_t i_size, i_ret, i_ret_blocks;
 
     i_size = (off_t)i_blocks * (off_t)DVDCSS_BLOCK_SIZE;
-    i_ret = read( dvdcss->i_fd, p_buffer, i_size );
-
-    if( i_ret < 0 )
+    i_ret = 0;
+    while (i_ret < i_size)
     {
-        print_error( dvdcss, "read error" );
+      off_t i_r;
+      i_r = read(dvdcss->i_fd, ((char*)p_buffer) + i_ret, i_size - i_ret);
+      if (i_r < 0)
+      {
+        print_error(dvdcss, "read error");
         dvdcss->i_pos = -1;
-        return i_ret;
+        return i_r;
+      }
+      if (i_r == 0)
+        break;
+
+      i_ret += i_r;
     }
 
     i_ret_blocks = i_ret / DVDCSS_BLOCK_SIZE;
