+set(PY_NUGET_VERSION 3.13.9)
+file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/bin)
+# Based on PCbuild\find_python.bat that allows us to cache to ${CMAKE_CURRENT_BINARY_DIR}/bin
+add_custom_target(script.find_python
+    COMMAND @Powershell "Invoke-WebRequest https://aka.ms/nugetclidl -OutFile 'bin/nuget.exe'"
+    COMMAND bin/nuget.exe install pythonx86 -Version ${PY_NUGET_VERSION} -OutputDirectory bin
+  BYPRODUCTS
+    bin/pythonx86.${PY_NUGET_VERSION}/tools/python.exe
+)
