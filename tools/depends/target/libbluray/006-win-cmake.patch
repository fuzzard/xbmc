+)
+
+# BD-J
+# default setting for BD-J build
+set(HAVE_JNI_H 0)
+
+if(NOT WINDOWS_STORE)
+  find_package(Java COMPONENTS Development)
+  if(Java_Development_FOUND)
+    # Use jni from libbluray tree
+    include_directories(${CMAKE_CURRENT_SOURCE_DIR}/jni)
+    include_directories(${CMAKE_CURRENT_SOURCE_DIR}/jni/win32)
+
+    if(Java_VERSION_MAJOR VERSION_GREATER_EQUAL "20")
+      set(java_versions -Djava_version_asm=1.8 -Djava_version_bdj=1.8)
+    elseif(Java_VERSION_MAJOR VERSION_GREATER_EQUAL "12")
+      set(java_versions -Djava_version_asm=1.7 -Djava_version_bdj=1.7)
+    elseif(Java_VERSION_MAJOR VERSION_GREATER_EQUAL "9")
+      set(java_versions -Djava_version_asm=1.6 -Djava_version_bdj=1.6)
+    else()
+      set(java_versions -Djava_version_asm=1.5 -Djava_version_bdj=1.4)
+    endif()
+
+    if(EXISTS $ENV{ANT_HOME})
+      find_program(ANT_EXECUTABLE NAMES ant PATHS $ENV{ANT_HOME}/bin)
+      if(ANT_EXECUTABLE)
+        set(ANT_BUILD ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/bdj/build.xml)
+
+        if(VERBOSE)
+          message(STATUS "ANT command: ${ANT_EXECUTABLE} -f ${ANT_BUILD} -Ddist=\"${CMAKE_CURRENT_BINARY_DIR}\" -Dsrc_awt=:java-j2se ${java_versions} -Dversion=\"j2se-${libbluray_VERSION}\"")
+        endif()
+
+        add_custom_target(ANT COMMENT "compiling libbluray.jar"
+                              COMMAND ${ANT_EXECUTABLE} -f "${ANT_BUILD}"
+                                      -Ddist="${CMAKE_CURRENT_BINARY_DIR}"
+                                      -Dsrc_awt=:java-j2se
+                                      ${java_versions}
+                                      -Dversion="j2se-${libbluray_VERSION}")
+
+        set(HAVE_JNI_H 1)
+        list(APPEND SRCS ${BDJ_SRCS})
+      else()
+        message(STATUS "Ant executable not found, can't compile libbluray.jar. Disabling BD-J support")
+      endif()
+    else()
+      message(STATUS "Apache-ant path not set via environment variable (ANT_HOME), can't compile libbluray.jar. Disabling BD-J support")
+    endif()
+  else()
+    message(STATUS "Java not found. Disabling BD-J support")
+  endif()
+endif()
+
+add_library(libbluray SHARED ${SRCS})
+
+if(TARGET ANT)
+  add_dependencies(libbluray ANT)
+endif()
+
+set_target_properties(libbluray PROPERTIES
+                                PDB_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
+                                PDB_NAME libbluray
+                                PDB_NAME_DEBUG libblurayd
+)
+
+target_compile_definitions(libbluray PRIVATE HAVE_CONFIG_H
+                                             _CRT_SECURE_NO_WARNINGS
+                                             BLURAY_API_EXPORT)
+
+target_link_options(libbluray PRIVATE /INCREMENTAL:NO
+                                      $<$<NOT:$<CONFIG:Release>>:/debug:full>)
+
+target_link_libraries(libbluray PRIVATE freetype::freetype
+                                        iconv::iconv
+                                        libxml2::libxml2
+                                        libudfread::libudfread
+                                        $<$<NOT:$<BOOL:WINDOWS_STORE>>:shell32.lib>
+                                        $<$<NOT:$<BOOL:WINDOWS_STORE>>:advapi32.lib>
+                                        $<$<NOT:$<BOOL:WINDOWS_STORE>>:gdi32.lib>)
+
+target_include_directories(libbluray
+    PRIVATE $<BUILD_INTERFACE:.;cmake;src;src/libbluray;${CMAKE_CURRENT_BINARY_DIR}>
+    INTERFACE $<INSTALL_INTERFACE:include/libbluray>
+)
+
+CONFIGURE_FILE(${CMAKE_CURRENT_SOURCE_DIR}/config.h.cm ${CMAKE_CURRENT_BINARY_DIR}/config.h)
+
+include(CMakePackageConfigHelpers)
+write_basic_package_version_file(${CMAKE_CURRENT_BINARY_DIR}/libbluray-config-version.cmake
+                                 VERSION ${libbluray_VERSION}
+                                 COMPATIBILITY AnyNewerVersion)
+
+install(TARGETS libbluray EXPORT libbluray
+        RUNTIME DESTINATION bin
+        ARCHIVE DESTINATION lib
+        LIBRARY DESTINATION lib)
+
+install(FILES ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/bluray-version.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/file/filesystem.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/bluray.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/decoders/overlay.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/keys.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/player_settings.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/util/log_control.h
+              ${CMAKE_CURRENT_SOURCE_DIR}/src/libbluray/bdnav/meta_data.h
+        DESTINATION include/libbluray)
+
+install(FILES $<TARGET_PDB_FILE:libbluray>
+        DESTINATION lib
+        OPTIONAL)
+
+if(HAVE_JNI_H)
+  install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libbluray-j2se-${libbluray_VERSION}.jar
+                ${CMAKE_CURRENT_BINARY_DIR}/libbluray-awt-j2se-${libbluray_VERSION}.jar
+          DESTINATION bin)
+endif()
+
+install(EXPORT libbluray
+        FILE libbluray.cmake
+        NAMESPACE libbluray::
+        DESTINATION lib/cmake/libbluray)
+
+install(FILES cmake/libbluray-config.cmake
+              ${CMAKE_CURRENT_BINARY_DIR}/libbluray-config-version.cmake
+        DESTINATION lib/cmake/libbluray)
+
